APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Optional backend-only API credentials; supply valid restricted values locally.
GOOGLE_MAPS_API_KEY=
CURRENCY_CONVERTER_API_KEY=

# Frontend map services require restricted browser-side tokens through
# window.MEDICALEER_MAP_KEYS (here/mapbox/bing/locationiq).
# Never put server-side secrets in client-side JavaScript.

# Legacy Realogy parser integrations
REALOGY_GEOCODER_API_KEY=
REALOGY_CLIENT_ID=
REALOGY_CLIENT_SECRET=
REALOGY_API_KEY=
REALOGY_C21_GEOCODER_API_KEY=
REALOGY_C21_CLIENT_ID=
REALOGY_C21_CLIENT_SECRET=
REALOGY_C21_API_KEY=
REALOGY_CB_GEOCODER_API_KEY=
REALOGY_CB_CLIENT_ID=
REALOGY_CB_CLIENT_SECRET=
REALOGY_CB_API_KEY=
REALOGY_COR_GEOCODER_API_KEY=
REALOGY_COR_CLIENT_ID=
REALOGY_COR_CLIENT_SECRET=
REALOGY_COR_API_KEY=

# Legacy Zezoom integration
ZEZOOM_HERE_AUTH_1=
ZEZOOM_HERE_AUTH_2=
ZEZOOM_GOOGLE_MAPS_API_KEY=
